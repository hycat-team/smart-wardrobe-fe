# Copy sang .env (local) hoặc cấu hình tương ứng trên hosting production.
# Phải cấu hình URL backend trước khi build/redeploy.
# Ứng dụng báo lỗi khi thiếu cấu hình, không dùng URL hardcode thay thế.

# Backend base, luôn kèm /api/v1. Dùng cho rewrites /api/v1/* (chốt lúc BUILD)
# và cho server-side (serverFetch, OAuth proxy).
BACKEND_API_URL=http://localhost:8080/api/v1

# Server-only. Không đưa key thời tiết xuống client bundle.
WEATHER_API_KEY=your_weather_api_key

# Public, không phải secret.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Reserved cho Google login/One Tap sau này; hiện frontend chưa đọc biến này.
NEXT_PUBLIC_GOOGLE_CLIENT_IDS=your_google_client_ids

# Optional: origin dùng để render preview URL brand khi đăng ký.
# Nếu thiếu, app tự dùng window.location.origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flag brand. false/không set = ẩn toàn bộ UI và chặn route brand.
NEXT_PUBLIC_ENABLE_BRAND_FEATURES=false
