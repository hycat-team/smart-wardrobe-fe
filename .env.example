# Copy sang .env (local) hoặc cấu hình tương ứng trên hosting production.
# QUAN TRỌNG (production): phải set đủ 2 biến rồi mới build/redeploy,
# nếu không BFF sẽ fetch về localhost:8080 -> ECONNREFUSED -> login 500/503.

# Backend base, luôn kèm /api/v1. Dùng cho rewrites /api/v1/* (chốt lúc BUILD)
# và làm fallback cho server khi thiếu BACKEND_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Backend base cho server-only (Route Handlers, middleware, serverFetch).
# Ưu tiên biến này ở runtime vì không bị bake vào client bundle.
# Production: set thành URL backend thật, ví dụ:
# BACKEND_API_URL=https://<backend-host>/api/v1
BACKEND_API_URL=http://localhost:8080/api/v1

NEXT_PUBLIC_API_WEATHER=your_weather_api_key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
